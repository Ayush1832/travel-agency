# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/travel-b2b

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Bcrypt ───────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Email (SMTP — Gmail or any provider) ────────────────────────────────────
# Gmail: enable 2FA → Google Account → Security → App Passwords → generate one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=yourname@gmail.com

# ─── Currency ─────────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=AED

# ─── PayTabs (MENA / UAE) ─────────────────────────────────────────────────────
PAYTABS_SERVER_KEY=
PAYTABS_PROFILE_ID=
PAYTABS_REGION=ARE
PAYTABS_SANDBOX=true

# ─── TBO Holidays API ─────────────────────────────────────────────────────────
TBO_API_URL=http://api.tbotechnology.in/HotelAPI_v7/HotelService.svc
TBO_CLIENT_ID=
TBO_API_USERNAME=
TBO_API_KEY=
TBO_SANDBOX=false

# ─── App URLs ─────────────────────────────────────────────────────────────────
CLIENT_APP_URL=http://localhost:4200
ADMIN_APP_URL=http://localhost:4201

# ─── Seed Admin ───────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@travelb2b.ae
SEED_ADMIN_PASSWORD=Admin@123456
